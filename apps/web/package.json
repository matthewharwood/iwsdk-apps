{
  "name": "@iwsdk-apps/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:quest-dev": "bun scripts/check-quest-dev.ts",
    "dev": "bun run sync:xr && vite --host 0.0.0.0 --port 3000",
    "dev:quest": "bun run sync:xr && XR_DEV=true vite --host 0.0.0.0 --port 3000",
    "build": "bun run sync:xr && vite build && bun scripts/build-offline.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3010",
    "typecheck": "tsgo --noEmit",
    "test:e2e": "bun scripts/build-xr-test.ts && playwright test",
    "storybook": "storybook dev -p 6010 --no-open",
    "build-storybook": "storybook build",
    "sync:xr": "bun scripts/sync-xr-assets.ts"
  },
  "dependencies": {
    "@iwsdk-apps/schemas": "workspace:*",
    "@iwsdk-apps/game-core": "workspace:*",
    "@iwsdk-apps/storage-sqlite": "workspace:*",
    "@iwsdk-apps/ai": "workspace:*",
    "@iwsdk/core": "0.5.3",
    "three": "0.181.2",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "jotai": "2.20.2",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@preact/signals-core": "1.14.4"
  },
  "devDependencies": {
    "@iwsdk/scene-composition": "0.5.3",
    "@zappar/msdf-generator": "1.2.4",
    "three-viewport-gizmo": "2.2.0",
    "@iwsdk-apps/tsconfig": "workspace:*",
    "@iwsdk/vite-plugin-dev": "0.5.3",
    "@playwright/test": "1.61.1",
    "@storybook/react-vite": "10.5.2",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-docs": "10.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.181.0",
    "@types/webxr": "0.5.24",
    "babel-plugin-react-compiler": "1.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "storybook": "10.5.2",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "@webxr-input-profiles/assets": "1.0.19",
    "iwer": "2.3.0"
  }
}
