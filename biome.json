{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!apps/printable-card-studio",
      "!.commander",
      "!.idea",
      "!**/routeTree.gen.ts",
      "!**/dist",
      "!**/node_modules",
      "!**/storybook-static",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.turbo",
      "!**/.generated",
      "!**/.tanstack",
      "!**/public/litert",
      "!**/public/sqlite",
      "!**/public/xr-profiles"
    ],
    "maxSize": 2000000
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
