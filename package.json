{
  "name": "iwsdk-apps",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@iwsdk-apps/web",
    "dev:quest": "turbo run dev:quest --filter=@iwsdk-apps/web",
    "build": "turbo run build",
    "typecheck": "tsgo --noEmit -p tsconfig.json && turbo run typecheck",
    "test:unit": "bun test packages scripts apps/web/app",
    "test:browser": "bun run --cwd apps/web test:e2e",
    "test:quest-dev": "bun run --cwd apps/web test:quest-dev",
    "storybook": "bun run --cwd apps/web storybook",
    "gen:app": "bun scripts/create-app.ts",
    "gen:workspace": "bun scripts/create-workspace.ts",
    "check:template": "bun scripts/check-template.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "lint": "biome check . --error-on-warnings && stylelint \"apps/*/app/**/*.css\" --max-warnings 0 && eslint . --max-warnings 0",
    "format": "biome check --write .",
    "check:fast": "bun run check:boundaries && bun run lint && bun run typecheck && bun run test:unit",
    "check": "bun run check:fast && bun run build && bun run test:browser && bun run test:quest-dev && bun run check:template"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "1.3.14",
    "@turbo/gen": "2.9.6",
    "@typescript/native-preview": "7.0.0-dev.20260426.1",
    "turbo": "2.9.6",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "36.0.1",
    "eslint": "10.7.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "typescript-eslint": "8.64.0"
  }
}
